# ==========================================
# ANDROIDSTORE MULTI-SELLER API SYSTEM — ENV EXAMPLE
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi produksi Anda.
# ==========================================

# Server Port
PORT=5000

# Security Encryption & JWT Secret (Wajib diganti dengan string acak yang aman untuk production)
ENCRYPTION_KEY=ganti_dengan_kunci_enkripsi_32_byte_yang_sangat_aman_dan_rahasia
JWT_SECRET=ganti_dengan_jwt_secret_yang_sangat_aman_dan_rahasia
ADMIN_EMAIL=androidstore279@gmail.com
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_sangat_aman

# MySQL 8 Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password_database_anda
DB_NAME=androidstore_db

# Cloudflare R2 Object Storage (Opsional - jika kosong otomatis fallback ke penyimpanan lokal /public/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=androidstore-payment-proofs
R2_ENDPOINT=

# Telegram Bot Notification Configuration (Untuk notifikasi pesanan masuk otomatis)
TELEGRAM_BOT_TOKEN=masukkan_token_bot_dari_botfather
TELEGRAM_CHAT_ID=masukkan_chat_id_telegram_anda

# Cloudflare Turnstile Anti-Bot Protection (Untuk keamanan form login admin)
CAPTCHA_SECRET_KEY=masukkan_cloudflare_secret_key
CAPTCHA_ENABLED=true

# External Supplier API Keys (Contoh Kredensial Reseller / Supplier)
VITE_API_KEY=
X-API-KEY=
ABELLAB_API_KEY=
VITE_ABELLAB_API_KEY=
